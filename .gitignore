# Build outputs (regenerable, never commit)
target/

# Python bytecode / virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Retail-derived data: regenerable from the player's own install, never commit.
# The developer fixtures are Blizzard data too: kept locally, regenerated per
# engine-rust/fixtures/README.md (build.rs substitutes placeholders when absent).
engine-rust/assets/
.galaxycraft-cache/
engine-rust/fixtures/*
!engine-rust/fixtures/README.md
!engine-rust/fixtures/SHA256SUMS
!engine-rust/fixtures/audio/
engine-rust/src/menu_masks/

# RE heavy outputs: local-only (memory dumps, Ghidra projects, run logs)
research/work/
research/build/
research/logs/

# Harness outputs
*.bmp

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# Secrets (checked-in templates are fine)
.env
!.env.example

# Copyrighted retail captures and reference-derived corrections are local-only.
engine-rust/docs/original_screenshots/
engine-rust/fixtures/calibration/
research/analysis/
*.png
*.jpg
*.jpeg
*.gif
*.webm
*.mp4
engine-rust/docs/evidence/
research/docs/rea-evidence-c.md

